#!/usr/bin/env python3
"""Entry point. Works from the plugin root (Herdr hooks), a symlink, or a shim."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

from whisper_lib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
